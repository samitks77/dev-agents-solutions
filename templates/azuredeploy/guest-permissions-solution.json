{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources."
      }
    },
    "managedIdentityName": {
      "type": "string",
      "defaultValue": "mi-guest-permissions",
      "metadata": {
        "description": "User-assigned managed identity used by the pipeline runtime."
      }
    },
    "logAnalyticsWorkspaceName": {
      "type": "string",
      "defaultValue": "law-guest-permissions",
      "metadata": {
        "description": "Log Analytics workspace for telemetry and logs."
      }
    },
    "containerAppsEnvironmentName": {
      "type": "string",
      "defaultValue": "cae-guest-permissions",
      "metadata": {
        "description": "Container Apps environment for job runtime."
      }
    },
    "grafanaName": {
      "type": "string",
      "defaultValue": "amg-guest-permissions",
      "metadata": {
        "description": "Azure Managed Grafana instance name."
      }
    },
    "fileShareName": {
      "type": "string",
      "defaultValue": "guest-permissions",
      "metadata": {
        "description": "Azure Files share for snapshot persistence."
      }
    },
    "grafanaOperatorObjectId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional Entra object ID to grant Reader on Grafana and Log Analytics Reader on workspace. Leave empty to skip."
      }
    }
  },
  "variables": {
    "storageAccountName": "[toLower(concat('stgp', take(uniqueString(resourceGroup().id), 18)))]",
    "readerRoleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'acdd72a7-3385-48ef-bd42-f606fba81ae7')]",
    "logAnalyticsReaderRoleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '73c42c96-874c-492b-b04d-ab87d138a893')]"
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[parameters('managedIdentityName')]",
      "location": "[parameters('location')]"
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2022-10-01",
      "name": "[parameters('logAnalyticsWorkspaceName')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30,
        "features": {
          "searchVersion": 1
        }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('storageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "allowBlobPublicAccess": false,
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/fileServices",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/default', variables('storageAccountName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/fileServices/shares",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/default/{1}', variables('storageAccountName'), parameters('fileShareName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/fileServices', variables('storageAccountName'), 'default')]"
      ],
      "properties": {
        "enabledProtocols": "SMB"
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[parameters('containerAppsEnvironmentName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsWorkspaceName'))]"
      ],
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsWorkspaceName')), '2022-10-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsWorkspaceName')), '2022-10-01').primarySharedKey]"
          }
        }
      }
    },
    {
      "type": "Microsoft.Dashboard/grafana",
      "apiVersion": "2023-09-01",
      "name": "[parameters('grafanaName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicNetworkAccess": "Enabled",
        "zoneRedundancy": "Disabled",
        "deterministicOutboundIP": "Disabled",
        "apiKey": "Enabled"
      }
    },
    {
      "condition": "[not(empty(parameters('grafanaOperatorObjectId')))]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.Dashboard/grafana', parameters('grafanaName')), parameters('grafanaOperatorObjectId'), variables('readerRoleDefinitionId'))]",
      "scope": "[resourceId('Microsoft.Dashboard/grafana', parameters('grafanaName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Dashboard/grafana', parameters('grafanaName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[variables('readerRoleDefinitionId')]",
        "principalId": "[parameters('grafanaOperatorObjectId')]",
        "principalType": "User"
      }
    },
    {
      "condition": "[not(empty(parameters('grafanaOperatorObjectId')))]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsWorkspaceName')), parameters('grafanaOperatorObjectId'), variables('logAnalyticsReaderRoleDefinitionId'))]",
      "scope": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsWorkspaceName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsWorkspaceName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[variables('logAnalyticsReaderRoleDefinitionId')]",
        "principalId": "[parameters('grafanaOperatorObjectId')]",
        "principalType": "User"
      }
    }
  ],
  "outputs": {
    "managedIdentityClientId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('managedIdentityName')), '2023-01-31').clientId]"
    },
    "managedIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('managedIdentityName')), '2023-01-31').principalId]"
    },
    "logAnalyticsWorkspaceId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsWorkspaceName')), '2022-10-01').customerId]"
    },
    "containerAppsEnvironmentId": {
      "type": "string",
      "value": "[resourceId('Microsoft.App/managedEnvironments', parameters('containerAppsEnvironmentName'))]"
    },
    "storageAccountName": {
      "type": "string",
      "value": "[variables('storageAccountName')]"
    },
    "fileShareName": {
      "type": "string",
      "value": "[parameters('fileShareName')]"
    },
    "grafanaName": {
      "type": "string",
      "value": "[parameters('grafanaName')]"
    },
    "grafanaEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Dashboard/grafana', parameters('grafanaName')), '2023-09-01').endpoint]"
    }
  }
}
