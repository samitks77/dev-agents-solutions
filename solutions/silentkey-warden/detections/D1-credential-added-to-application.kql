// =====================================================================================
// D1 - Credential added to an application (MITRE ATT&CK T1098.001)
// -------------------------------------------------------------------------------------
// Maps to  : POC Test B - Suspicious Credential Addition (Backdoor Persistence)
// Table    : AuditLogs            (diagnostic category: AuditLogs)
// Severity : 2 (Warning)
// -------------------------------------------------------------------------------------
// What it finds
//   An app registration whose credential collection GREW - a new client secret or
//   certificate was added alongside the existing one. Deleting or rotating a credential
//   in place does not fire this; only a net increase does.
//
// Why it matters
//   Adding a second secret is the quietest persistence technique available against a
//   workload identity. The attacker ends up with their own key to the application,
//   independent of the original secret, and nothing alerts on it by default. Rotating
//   the legitimate secret does not evict them.
//
// Triage
//   1. Is the initiator an approved app owner or an automation identity you recognise?
//   2. Was there a change request or pipeline run at that timestamp?
//   3. If not: confirm the SP compromised, remove the rogue credential, rotate the
//      legitimate one, then dismiss the risk. In that order.
//
// Note on time filters
//   The deployed alert rule omits `ago()` because Azure Monitor applies the rule's
//   windowSize automatically. The `ago()` below is for interactive hunting only.
// =====================================================================================

let Lookback = 7d;
AuditLogs
| where TimeGenerated > ago(Lookback)
| where Category == "ApplicationManagement"
| where OperationName has_all ("Update application", "Certificates and secrets management")
| extend TargetApp   = tostring(TargetResources[0].displayName)
| extend TargetAppId = tostring(TargetResources[0].id)
| extend Initiator   = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName), "unknown")
| extend InitiatorIp = tostring(InitiatedBy.user.ipAddress)
| mv-expand ModifiedProperty = TargetResources[0].modifiedProperties
| where tostring(ModifiedProperty.displayName) == "KeyDescription"
| extend OldKeys = tostring(ModifiedProperty.oldValue), NewKeys = tostring(ModifiedProperty.newValue)
| extend OldKeyCount = countof(OldKeys, "KeyIdentifier"), NewKeyCount = countof(NewKeys, "KeyIdentifier")
| where NewKeyCount > OldKeyCount
| project TimeGenerated, TargetApp, TargetAppId, Initiator, InitiatorIp, OldKeyCount, NewKeyCount, Result, CorrelationId
| order by TimeGenerated desc
