{
  "name": "@dev-agents-solutions/entra-cba-playwright",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:app": "node scripts/build-app.mjs",
    "test": "playwright test --project=cba-feasibility",
    "test:headed": "playwright test --project=cba-feasibility --headed",
    "test:wrong-origin": "playwright test --project=cba-wrong-origin",
    "test:session": "playwright test --project=authenticated-session",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@azure/msal-browser": "5.19.0",
    "@playwright/test": "1.62.1",
    "@types/node": "26.3.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
